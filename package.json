{
  "name": "@gupta799/icc-sdk",
  "version": "0.3.0",
  "type": "module",
  "description": "Independent TypeScript purchasing-agent SDK with ICC and Direct VIC integrations for prototypes and sandbox development",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CONTRACT.md",
    "docs"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.check.json",
    "pretest": "npm run build",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "predemo": "npm run build",
    "demo": "node --experimental-strip-types examples/checkout.ts",
    "test:package": "node scripts/package-smoke.mjs",
    "prepack": "npm run build && npm run check",
    "verify": "npm test && npm run check && npm run demo && npm run demo:agent && npm run test:package",
    "demo:agent": "node --experimental-strip-types examples/agent.ts",
    "predemo:agent": "npm run build"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "cybersource-rest-client": "0.0.84",
    "pg": "8.23.1",
    "typescript": "^5.9.3"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gupta799/ICC_SDK.git"
  },
  "homepage": "https://github.com/gupta799/ICC_SDK#readme",
  "bugs": {
    "url": "https://github.com/gupta799/ICC_SDK/issues"
  },
  "keywords": [
    "agentic-commerce",
    "purchasing-agent",
    "icc",
    "visa-intelligent-commerce",
    "checkout",
    "typescript"
  ],
  "sideEffects": false
}
